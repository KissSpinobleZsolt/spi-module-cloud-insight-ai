        "refresh": "Reîmprospătare",
        "export": "Exportă",
        "colName": "Nume",
        "colType": "Tip",
        "colRows": "Rânduri",
        "colSize": "Dimensiune",
        "colStatus": "Status",
        "colUpdated": "Actualizat",
        "statusReady": "gata",
        "statusProcessing": "procesare",
        "statusError": "eroare"
      }
    }
    },
    "bots": [
      {
        "name": "CloudInsight Monitor",
        "type": "custom",
        "description": "Monitors ingestion jobs and reports anomalies or failures.",
        "model": "",
        "system_prompt": "You are a data pipeline monitor. Analyze ingestion run summaries and report anomalies, failures, or data quality issues in structured form.",
        "icon": "👁️",
        "active": true,
        "restricted": "user",
        "provider": "ollama",
        "config_schema": {
          "principals": "sources",
          "configurations": [
            { "key": "error_threshold_pct", "label": "Error rate threshold (%)", "type": "number", "min": 0, "max": 100, "step": 5, "default": 20 },
            { "key": "stale_hours", "label": "Stale source threshold (hours)", "type": "number", "min": 1, "max": 168, "step": 1, "default": 24 },
            { "key": "min_row_count", "label": "Min expected row count", "type": "number", "min": 0, "max": 100000, "step": 100, "default": 0 },
            { "key": "notify_on_quality", "label": "Report data quality issues", "type": "boolean", "default": true }
          ],
          "scheduler": [
            { "key": "scan_interval_minutes", "label": "Monitor interval (minutes)", "type": "number", "min": 5, "max": 120, "step": 5, "default": 60 }
          ]
        }
      }
    ]
  }
}
