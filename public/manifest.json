        "colName": "Name",
        "colType": "Type",
        "colRows": "Rows",
        "colSize": "Size",
        "colStatus": "Status",
        "colUpdated": "Updated",
        "statusReady": "ready",
        "statusProcessing": "processing",
        "statusError": "error"
      }
    },
    "ro": {
      "cloudInsightAI": {
        "title": "Ingestie Date",
        "subtitle": "Încarcă, procesează și gestionează surse de date structurate pentru spațiul tău de lucru.",
        "newConnection": "+ Conexiune nouă",
        "dataSources": "Surse de date",
        "totalRecords": "Total înregistrări",
        "lastIngestion": "Ultima ingestie",
        "storageUsed": "Stocare utilizată",
